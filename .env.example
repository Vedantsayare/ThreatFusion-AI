# ==============================================================================
#  ThreatFusion AI — Environment Variable Template
#  Copy this file to .env and fill in real values.
#  The .env file is NEVER committed to git.
#
#  Container image versions (pinned in docker-compose.yml):
#    PostgreSQL 16.4-alpine  |  Redis 7.4-alpine  |  Neo4j 5.24-community
#  To update a version, change the tag in docker-compose.yml, run
#  `docker compose pull`, verify health, then commit.
# ==============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# ── Wazuh (existing Ubuntu VM) ────────────────────────────────────────────────
# Set WAZUH_VERIFY_SSL=false only when the VM uses a self-signed certificate.
WAZUH_API_URL=https://192.168.114.140:55000
WAZUH_API_USER=wazuh-api-user
WAZUH_API_PASSWORD=REPLACE_WITH_WAZUH_PASSWORD
WAZUH_VERIFY_SSL=false
WAZUH_POLL_INTERVAL_SECONDS=15
WAZUH_TIMEOUT_SECONDS=10

# ── PostgreSQL 16 ─────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=threatfusion
POSTGRES_USER=threatfusion_user
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_PASSWORD

# ── Redis 7 ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD

# ── Neo4j Community 5.x ───────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE_WITH_NEO4J_PASSWORD

# ── MISP Threat Intelligence ──────────────────────────────────────────────────
# A missing enrichment result is treated as UNKNOWN, never as "safe".
MISP_URL=https://misp.local
MISP_API_KEY=REPLACE_WITH_MISP_API_KEY
MISP_VERIFY_SSL=false
MISP_TIMEOUT_SECONDS=10

# ── LLM Provider (multi-tier) ─────────────────────────────────────────────────
# Supported providers: openai | anthropic | gemini | ollama
LLM_PROVIDER=openai
FAST_LLM_MODEL=gpt-4o-mini          # Triage agent — cheap / fast
REASONING_LLM_MODEL=gpt-4o          # Investigation agent — stronger reasoning
LLM_API_KEY=REPLACE_WITH_LLM_API_KEY

# ── Guardrail policy limits ───────────────────────────────────────────────────
# Hard limits enforced by the deterministic policy engine, not the LLM.
MAX_ISOLATION_BLAST_RADIUS=3
PRIVILEGED_ACCOUNTS_REQUIRE_MANUAL_OVERRIDE=true

# ── Docker host port overrides (optional) ────────────────────────────────────
# All ports default to localhost (127.0.0.1) and standard port numbers.
# Override here only if you have conflicts on your development machine.
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# NEO4J_HTTP_HOST_PORT=7474
# NEO4J_BOLT_HOST_PORT=7687
