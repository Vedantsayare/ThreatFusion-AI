# ==============================================================================
#  ThreatFusion AI — Environment Variable Template
#  Copy this file to .env and fill in real values.
#  The .env file is NEVER committed to git.
#
#  Container image versions (pinned in docker-compose.yml):
#    PostgreSQL 16.4-alpine  |  Redis 7.4-alpine  |  Neo4j 5.24-community
#  To update a version, change the tag in docker-compose.yml, run
#  `docker compose pull`, verify health, then commit.
# ==============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# Tip: `python scripts/bootstrap_env.py` copies this file to .env and fills every
# CHANGE_ME / database password / API key with a random value.

# ── API authentication (role-based) ──────────────────────────────────────────
# Comma-separated name:role:key triples. Roles: viewer < analyst < approver < admin.
#   viewer   — read-only dashboards, incidents, graph, audit log
#   analyst  — + ingest alerts, load demo scenarios, notes, status, propose actions
#   approver — + approve/reject/execute response actions
# Keys containing CHANGE_ME are ignored. With no valid keys every protected
# endpoint returns 401 (fail closed).
API_KEYS=viewer:viewer:CHANGE_ME_viewer_key,analyst:analyst:CHANGE_ME_analyst_key,approver:approver:CHANGE_ME_approver_key
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Throttling (per client IP, in-process). Behind a reverse proxy or the Vite dev
# proxy all browsers share one IP, so a lockout affects everyone using it.
RATE_LIMIT_PER_MINUTE=600      # 0 disables
AUTH_MAX_FAILURES=10           # failed auths before lockout; 0 disables
AUTH_LOCKOUT_SECONDS=300
MAX_REQUEST_BYTES=262144
APPROVAL_TIMEOUT_SECONDS=1800

# ── Persistence ───────────────────────────────────────────────────────────────
# postgres — use the PostgreSQL service from docker-compose (recommended)
# sqlite   — single local file (no Docker needed); path set by SQLITE_PATH
PERSISTENCE_BACKEND=postgres
SQLITE_PATH=./threatfusion.db

# ── Demo mode ─────────────────────────────────────────────────────────────────
# Enables the clearly labelled synthetic threat-intel feed and demo scenarios.
# Synthetic data is always tagged source=demo_* in API responses and the UI.
DEMO_MODE=true

# ── Graph ─────────────────────────────────────────────────────────────────────
# Set to false to run without Neo4j (graph views fall back to per-alert
# resolution data and are labelled as not persisted).
NEO4J_ENABLED=true

# ── Wazuh (existing Ubuntu VM) ────────────────────────────────────────────────
# WAZUH_ENABLED=true starts the background poller at API startup. Leave false
# to submit alerts through the API / dashboard only.
# Set WAZUH_VERIFY_SSL=false only when the VM uses a self-signed certificate.
WAZUH_ENABLED=false
WAZUH_API_URL=https://192.168.114.140:55000
WAZUH_API_USER=wazuh-api-user
WAZUH_API_PASSWORD=REPLACE_WITH_WAZUH_PASSWORD
WAZUH_VERIFY_SSL=false
WAZUH_POLL_INTERVAL_SECONDS=15
WAZUH_TIMEOUT_SECONDS=10
WAZUH_ALERTS_ENDPOINT=/alerts
WAZUH_BATCH_SIZE=100
WAZUH_MAX_RETRIES=3
WAZUH_RETRY_BACKOFF_SECONDS=1.0

# ── PostgreSQL 16 ─────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=threatfusion
POSTGRES_USER=threatfusion_user
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_PASSWORD

# ── Redis 7 ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD

# ── Neo4j Community 5.x ───────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE_WITH_NEO4J_PASSWORD

# ── MISP Threat Intelligence ──────────────────────────────────────────────────
# A missing enrichment result is treated as UNKNOWN, never as "safe".
MISP_URL=https://misp.local
MISP_API_KEY=REPLACE_WITH_MISP_API_KEY
MISP_VERIFY_SSL=false
MISP_TIMEOUT_SECONDS=10

# ── LLM Provider (optional) ───────────────────────────────────────────────────
# Used ONLY for the evidence-grounded investigation narrative. Triage scores,
# priorities, and guardrail decisions are deterministic and never use the LLM.
# Supported providers: none | anthropic | ollama  (openai/gemini: not implemented → template)
#   none      — deterministic template narrative (default; no key required)
#   anthropic — Claude via the official SDK (pip install -e ".[llm]")
#   ollama    — local model; LLM_BASE_URL defaults to http://localhost:11434
LLM_PROVIDER=none
FAST_LLM_MODEL=claude-haiku-5-5
REASONING_LLM_MODEL=claude-opus-5-5
LLM_API_KEY=REPLACE_WITH_LLM_API_KEY
# LLM_BASE_URL=

# ── Guardrail policy limits ───────────────────────────────────────────────────
# Hard limits enforced by the deterministic policy engine, not the LLM.
MAX_ISOLATION_BLAST_RADIUS=3
PRIVILEGED_ACCOUNTS_REQUIRE_MANUAL_OVERRIDE=true

# ── Docker host port overrides (optional) ────────────────────────────────────
# All ports default to localhost (127.0.0.1) and standard port numbers.
# Override here only if you have conflicts on your development machine.
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# NEO4J_HTTP_HOST_PORT=7474
# NEO4J_BOLT_HOST_PORT=7687
